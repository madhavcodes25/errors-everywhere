# Copy to server/.env and fill in. Every value can also come from real env vars.
# Leave MONGODB_URI empty for local dev: the server then starts an in-memory
# replica set (data is lost on restart, but change streams DO work).

MONGODB_URI=
PORT=4000
DATABASE_NAME=errors-everywhere

# LLM plain-English summary (Part 7). The app works fully with this OFF —
# the summary is then template-based (source: "template").
# The key stays on the server; it is never logged and never sent anywhere
# except the model provider endpoint.
LLM_ENABLED=false
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
API_KEY=
# Any /chat/completions-compatible endpoint works (OpenAI, Azure proxies, LM Studio...)
MODEL_BASE_URL=https://api.openai.com/v1

# Errors Everywhere environment configuration.
# Copy this file to server/.env (the server loads it from its own folder).
# The dashboard reads dashboard/.env separately (see dashboard/.env.example).

# MongoDB Atlas connection string. Must be a replica set (Atlas always is),
# because change streams (used by GET /stream) require one.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/errors-everywhere?retryWrites=true&w=majority

# Port for the Express API server.
PORT=4000

# Optional: skip this to let tests spin up a local in-memory replica set.
# DATABASE_NAME=errors-everywhere
